# Calliope agent env — copy to .env and fill what you have.

# --- LLM brains (optional; deterministic STUB model runs without these) ---
# OPENAI_API_KEY=
# XAI_API_KEY=

# --- Base settlement (optional; ×1.15 partner stack, no Virtuals required) ---
# Deploy contracts/CalliopeSettlement.sol then set:
# CALLIOPE_BASE_PRIVATE_KEY=0x...
# CALLIOPE_SETTLEMENT_ADDRESS=0x...
# CALLIOPE_BASE_CHAIN=base-sepolia
# CALLIOPE_BASE_RPC=https://sepolia.base.org

# --- Virtuals ACP registration (optional; activates real escrow hires) ---
# From the Calliope desk agent page on app.virtuals.io/acp:
# CALLIOPE_WALLET_ADDRESS=
# CALLIOPE_WALLET_ID=
# CALLIOPE_SIGNER_KEY=
# CALLIOPE_BUILDER_CODE=
# From the vendor agent page (atelier-jp) — its registered offering:
# VENDOR_WALLET_ADDRESS=
# VENDOR_OFFERING_NAME=

# --- Optional local paths ---
# CALLIOPE_AGENT_DIR=
# CALLIOPE_EVENT_LOG=
# CALLIOPE_DB=
# SIBYL_PYTHON=

# Legacy compatibility aliases (use CALLIOPE_* above for new setups):
# CHARTER_WALLET_ADDRESS=
# CHARTER_WALLET_ID=
# CHARTER_SIGNER_KEY=
# CHARTER_BUILDER_CODE=
# CHARTER_AGENT_DIR=
# CHARTER_EVENT_LOG=
