# Calliope agent env — copy to .env and fill what you have.

# --- LLM brains (optional; deterministic STUB model runs without these) ---
# OPENAI_API_KEY=
# XAI_API_KEY=

# --- Virtuals ACP registration (optional; activates real escrow hires) ---
# From the Calliope desk agent page on app.virtuals.io/acp:
# CALLIOPE_WALLET_ADDRESS=
# CALLIOPE_WALLET_ID=
# CALLIOPE_SIGNER_KEY=
# CALLIOPE_BUILDER_CODE=
# From the vendor agent page (atelier-jp) — its registered offering:
# VENDOR_WALLET_ADDRESS=
# VENDOR_OFFERING_NAME=

# --- Sibyl Memory MCP python (auto-detected default; override if needed) ---
# SIBYL_PYTHON=
